# Copy to `.env` ON THE VM (never commit the filled-in version) and replace every value.
# `docker compose` reads this file automatically from the directory it runs in.

# Leave unset for plain HTTP on the public IP. Set it to a domain to get an automatic
# Let's Encrypt certificate, which is what HTTPS and WSS require. See README.md.
#SITE_ADDRESS=appbuilder.example.com

# Postgres. The database is created on first boot with these credentials; changing them
# afterwards requires either a matching change inside Postgres or wiping the volume.
DB_NAME=appbuilder
DB_USER=appbuilder
DB_PASSWORD=

# Seeded superuser. ADMIN_UUID must be a UUID; generate one with `uuidgen`.
ADMIN_UUID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT. Generate the secret with `openssl rand -base64 48`.
JWT_ISSUER=appbuilder
JWT_AUDIENCE=appbuilder
JWT_SECRET=

# Optional. Without a Sentry DSN the server logs nothing in production mode, since
# ServerLogger is only registered in development.
SENTRY_DSN=
# Optional, only read when the firebase flag is on and credentials are mounted.
GCP_PROJECT_ID=
