# Environment variables to set on the container host. Mark the three secrets as secrets rather
# than plaintext when adding them, so they are not readable from the service page afterwards.

DEVELOPMENT=false

# Must match the port exposed by the service. Some hosts inject PORT themselves; setting it
# explicitly works either way.
PORT=8000

# Neon connection details, taken from the connection string on the Neon dashboard:
#   postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?sslmode=require
# The host is the full name ending in .neon.tech, and the port is Postgres's default.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Required by Neon, and by every hosted Postgres provider. Without it the connection is refused.
DB_SSL=true

# Seeded superuser. ADMIN_UUID must be a UUID; generate one with `uuidgen`.
ADMIN_UUID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Generate the secret with `openssl rand -base64 48`.
JWT_ISSUER=app-builder-server
JWT_AUDIENCE=app-builder-clients
JWT_SECRET=

# Optional. Production mode registers no logger of its own, so without a Sentry DSN the
# application's own telemetry goes nowhere and only Ktor and JVM output reaches the host's log view.
SENTRY_DSN=
