import kotlin.time.Instant;
import kotlin.uuid.Uuid;

CREATE TABLE IF NOT EXISTS Account (
    userUuid TEXT AS Uuid NOT NULL PRIMARY KEY,
    modifiedAt TEXT AS Instant NOT NULL,
    deletedAt TEXT AS Instant,
    username TEXT NOT NULL,
    permissions TEXT NOT NULL
);

truncateAccount:
DELETE FROM Account;

upsertAccount:
INSERT OR REPLACE INTO Account VALUES ?;

getAccounts:
SELECT Account.*
FROM Account;

getAccountsByUuids:
SELECT Account.*
FROM Account
WHERE Account.userUuid IN :userUuids;

getAccount:
SELECT Account.*
FROM Account
WHERE Account.userUuid = :userUuid;
