import com.app.builder.domain.Equipment;
import kotlin.time.Instant;
import kotlin.uuid.Uuid;

CREATE TABLE IF NOT EXISTS Equipment (
    uuid TEXT AS Uuid NOT NULL PRIMARY KEY,
    modifiedAt TEXT AS Instant NOT NULL,
    deletedAt TEXT AS Instant,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    status TEXT AS Equipment.Status NOT NULL
);

deleteEquipment:
UPDATE Equipment
SET modifiedAt = :utc,
    deletedAt = :utc
WHERE uuid = :equipmentUuid;

upsertEquipment:
INSERT OR REPLACE INTO Equipment VALUES ?;

getEquipments:
SELECT *
FROM Equipment;

getEquipmentsByUuids:
SELECT *
FROM Equipment
WHERE uuid IN :equipmentUuids;

getEquipment:
SELECT *
FROM Equipment
WHERE uuid = :equipmentUuid;
