import kotlin.time.Instant;
import kotlin.uuid.Uuid;

CREATE TABLE IF NOT EXISTS Building (
    uuid TEXT AS Uuid NOT NULL PRIMARY KEY,
    modifiedAt TEXT AS Instant NOT NULL,
    deletedAt TEXT AS Instant,
    name TEXT NOT NULL,
    code TEXT NOT NULL
);

truncateBuilding:
DELETE FROM Building;

deleteBuilding:
UPDATE Building
SET modifiedAt = :utc,
    deletedAt = :utc
WHERE uuid = :buildingUuid
    AND uuid IN (
        SELECT buildingUuid
        FROM BuildingUserJoin
        WHERE userUuid = :userUuid
    );

upsertBuilding:
INSERT OR REPLACE INTO Building VALUES ?;

getBuildings:
SELECT Building.*
FROM Building
INNER JOIN BuildingUserJoin ON Building.uuid = BuildingUserJoin.buildingUuid
WHERE BuildingUserJoin.userUuid = :userUuid;

getBuildingsByUuids:
SELECT Building.*
FROM Building
INNER JOIN BuildingUserJoin ON Building.uuid = BuildingUserJoin.buildingUuid
WHERE BuildingUserJoin.userUuid = :userUuid
AND Building.uuid IN :buildingUuids;

getBuilding:
SELECT Building.*
FROM Building
INNER JOIN BuildingUserJoin ON Building.uuid = BuildingUserJoin.buildingUuid
WHERE BuildingUserJoin.userUuid = :userUuid
AND Building.uuid = :buildingUuid;
