import kotlin.uuid.Uuid;

CREATE TABLE IF NOT EXISTS BuildingUserJoin (
    buildingUuid TEXT AS Uuid NOT NULL,
    userUuid TEXT AS Uuid NOT NULL,
    PRIMARY KEY (buildingUuid, userUuid)
);

truncateBuildingUserJoin:
DELETE FROM BuildingUserJoin;

upsertBuildingUserJoin:
INSERT OR REPLACE INTO BuildingUserJoin VALUES ?;
