import kotlin.Int;
import kotlin.time.Instant;
import kotlin.uuid.Uuid;

CREATE TABLE IF NOT EXISTS BuildingMaterial (
    uuid TEXT AS Uuid NOT NULL PRIMARY KEY,
    modifiedAt TEXT AS Instant NOT NULL,
    deletedAt TEXT AS Instant,
    buildingUuid TEXT AS Uuid NOT NULL,
    materialUuid TEXT AS Uuid NOT NULL,
    quantity INTEGER AS Int NOT NULL
);

CREATE INDEX IF NOT EXISTS building_material_building_uuid ON BuildingMaterial(buildingUuid);
CREATE INDEX IF NOT EXISTS building_material_material_uuid ON BuildingMaterial(materialUuid);

upsertBuildingMaterial:
INSERT OR REPLACE INTO BuildingMaterial VALUES ?;

getBuildingMaterialsByUuids:
SELECT *
FROM BuildingMaterial
WHERE uuid IN :buildingMaterialUuids;

getBuildingMaterial:
SELECT *
FROM BuildingMaterial
WHERE uuid = :buildingMaterialUuid;

getMaterialsInBuilding:
SELECT Material.*, BuildingMaterial.quantity
FROM Material
JOIN BuildingMaterial ON BuildingMaterial.materialUuid = Material.uuid
WHERE BuildingMaterial.buildingUuid = :buildingUuid
    AND BuildingMaterial.deletedAt IS NULL
    AND Material.deletedAt IS NULL;

getBuildingsOfMaterial:
SELECT Building.*, BuildingMaterial.quantity
FROM Building
JOIN BuildingMaterial ON BuildingMaterial.buildingUuid = Building.uuid
WHERE BuildingMaterial.materialUuid = :materialUuid
    AND BuildingMaterial.deletedAt IS NULL
    AND Building.deletedAt IS NULL;
