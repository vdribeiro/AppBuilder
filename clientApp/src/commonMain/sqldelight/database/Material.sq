import kotlin.time.Instant;
import kotlin.uuid.Uuid;

CREATE TABLE IF NOT EXISTS Material (
    uuid TEXT AS Uuid NOT NULL PRIMARY KEY,
    modifiedAt TEXT AS Instant NOT NULL,
    deletedAt TEXT AS Instant,
    name TEXT NOT NULL,
    description TEXT NOT NULL
);

deleteMaterial:
UPDATE Material
SET modifiedAt = :utc,
    deletedAt = :utc
WHERE uuid = :materialUuid;

upsertMaterial:
INSERT OR REPLACE INTO Material VALUES ?;

getMaterials:
SELECT *
FROM Material;

getMaterialsByUuids:
SELECT *
FROM Material
WHERE uuid IN :materialUuids;

getMaterial:
SELECT *
FROM Material
WHERE uuid = :materialUuid;
