import com.app.builder.domain.Task;
import kotlin.time.Instant;
import kotlin.uuid.Uuid;

CREATE TABLE IF NOT EXISTS Task (
    uuid TEXT AS Uuid NOT NULL PRIMARY KEY,
    modifiedAt TEXT AS Instant NOT NULL,
    deletedAt TEXT AS Instant,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    state TEXT AS Task.State NOT NULL
);

truncateTask:
DELETE FROM Task;

deleteTask:
UPDATE Task
SET modifiedAt = :utc,
    deletedAt = :utc
WHERE uuid = :taskUuid;

upsertTask:
INSERT OR REPLACE INTO Task VALUES ?;

getTasks:
SELECT *
FROM Task;

getTasksByUuids:
SELECT *
FROM Task
WHERE uuid IN :taskUuids;

getTask:
SELECT *
FROM Task
WHERE uuid = :taskUuid;
