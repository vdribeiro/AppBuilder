import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS Translation (
    languageIso TEXT NOT NULL,
    key TEXT NOT NULL,
    modifiedAt TEXT AS Instant NOT NULL,
    value TEXT NOT NULL,
    PRIMARY KEY(languageIso, key)
);

isTranslationEmpty:
SELECT Translation.key FROM Translation LIMIT 1;

truncateTranslation:
DELETE FROM Translation;

upsertTranslation:
INSERT OR REPLACE INTO Translation VALUES ?;

updateTranslation:
UPDATE Translation
SET modifiedAt = :modifiedAt, value = :value
WHERE languageIso = :languageIso AND key = :key;

deleteTranslation:
DELETE FROM Translation
WHERE languageIso = :languageIso AND key = :key;

getAllTranslations:
SELECT *
FROM Translation;

getTranslation:
SELECT *
FROM Translation
WHERE languageIso = :languageIso AND key = :key;

getTranslations:
SELECT *
FROM Translation
WHERE languageIso = :languageIso;

getLanguages:
SELECT DISTINCT Translation.languageIso
FROM Translation
ORDER BY Translation.languageIso;
